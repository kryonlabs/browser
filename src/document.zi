// A small HTML tree, CSS cascade and block layout. No external page engine.
using UI :: #import "kryon/Widgets";
#import "std/text_buffer"

Limit :: 240;
Style :: struct {
    color: u32
    background: u32
    font: s32
    margin: float32
    padding: float32
    width: float32
    hidden: bool
    centered: bool
}
Node :: struct {
    tag: string
    id: string
    classes: string
    href: string
    inline_style: string
    parent: s32
    first: s32
    last: s32
    next: s32
    text: [4097]u8
    size: s32
    style: Style
    bounds: Rectangle
}
Rule :: struct { selector: string; declarations: string; specificity: s32 }
nodes: [Limit]Node;
count: s32;
rules: [128]Rule;
rule_count: s32;
title: [257]u8;
page_color: u32;
height: float32;
truncated: bool;

Copy :: (out: []u8, value: string) {
    n:=cast(s32)value.count; if n>=cast(s32)out.count { n=cast(s32)out.count-1 }
    for i: 0..n-1 { out[i]=value[i] }; out[n]=0
}
Space :: (c: u8) -> bool { return c==32 || c==9 || c==10 || c==13 }
Trim :: (value: string) -> string {
    start: s32=0; end:=cast(s32)value.count
    while start<end && Space(value[start]) { start+=1 }
    while end>start && Space(value[end-1]) { end-=1 }
    return value[start:end]
}
Lower :: (c: u8) -> u8 { if c>=65 && c<=90 { return c+32 }; return c }
Same :: (a: string, b: string) -> bool {
    if a.count!=b.count { return false }
    for i: 0..cast(s32)a.count-1 { if Lower(a[i])!=Lower(b[i]) { return false } }; return true
}
Starts :: (value: string, prefix: string) -> bool { return value.count>=prefix.count && Same(value[:prefix.count],prefix) }
Find :: (value: string, needle: string, start: s32) -> s32 {
    for i: start..cast(s32)(value.count-needle.count) { if Same(value[i:i+cast(s32)needle.count],needle) { return i } }; return -1
}
Attribute :: (value: string, wanted: string) -> string {
    i: s32=0; end:=cast(s32)value.count
    while i<end {
        while i<end && (Space(value[i]) || value[i]==47) { i+=1 }
        begin:=i; while i<end && !Space(value[i]) && value[i]!=61 { i+=1 }
        name:=value[begin:i]
        while i<end && Space(value[i]) { i+=1 }
        if i>=end || value[i]!=61 { continue }; i+=1
        while i<end && Space(value[i]) { i+=1 }; if i>=end { break }
        quote: u8=0; if value[i]==34 || value[i]==39 { quote=value[i]; i+=1 }
        begin=i
        while i<end && ((quote!=0 && value[i]!=quote) || (quote==0 && !Space(value[i]))) { i+=1 }
        if Same(name,wanted) { return value[begin:i] }
        if quote!=0 && i<end { i+=1 }
    }; return ""
}
Add :: (parent: s32, tag: string) -> s32 {
    if count>=Limit { truncated=true; return -1 }
    i:=count; count+=1; nodes[i]=.{}; nodes[i].tag=tag; nodes[i].parent=parent; nodes[i].first=-1; nodes[i].last=-1; nodes[i].next=-1
    if parent>=0 {
        if nodes[parent].first<0 { nodes[parent].first=i } else { nodes[nodes[parent].last].next=i }
        nodes[parent].last=i
    }; return i
}
DecodeText :: (index: s32, value: string, pre: bool) {
    n: s32=0; i: s32=0; end:=cast(s32)value.count; was_space: bool
    while i<end && n<4096 {
        c:=value[i]
        if c==38 {
            semicolon:=Find(value,";",i+1)
            if semicolon>i && semicolon-i<12 {
                entity:=value[i:semicolon+1]; replacement: string
                if entity=="&amp;" { replacement="&" } else if entity=="&lt;" { replacement="<" } else if entity=="&gt;" { replacement=">" }
                else if entity=="&quot;" { replacement="\"" } else if entity=="&apos;" || entity=="&#39;" { replacement="'" } else if entity=="&nbsp;" { replacement=" " }
                if replacement!="" { c=replacement[0]; i=semicolon }
            }
        }
        if !pre && Space(c) { if !was_space { nodes[index].text[n]=32; n+=1 }; was_space=true }
        else { nodes[index].text[n]=c; n+=1; was_space=false }
        i+=1
    }
    nodes[index].text[n]=0; nodes[index].size=n
    if i<end { truncated=true }
}
ParseCSS :: (source: string) {
    i: s32=0
    while i<cast(s32)source.count && rule_count<128 {
        while i<cast(s32)source.count && Space(source[i]) { i+=1 }
        if i>=cast(s32)source.count { break }
        if Starts(source[i:],"/*") { close:=Find(source,"*/",i+2); if close<0 { break }; i=close+2; continue }
        open:=Find(source,"{",i); if open<0 { break }; close:=Find(source,"}",open+1); if close<0 { break }
        selectors:=Trim(source[i:open]); declarations:=source[open+1:close]; start: s32=0
        for j: 0..cast(s32)selectors.count {
            if j==cast(s32)selectors.count || selectors[j]==44 {
                selector:=Trim(selectors[start:j]); start=j+1
                if selector=="" || selector[0]==64 || rule_count>=128 { continue }
                score: s32=1; if selector[0]==46 { score=10 }; if selector[0]==35 { score=100 }
                rules[rule_count]=.{selector,declarations,score}; rule_count+=1
            }
        }; i=close+1
    }
}
Class :: (value: string, wanted: string) -> bool {
    start: s32=0
    for i: 0..cast(s32)value.count {
        if i==cast(s32)value.count || Space(value[i]) { if value[start:i]==wanted { return true }; start=i+1 }
    }; return false
}
Matches :: (node: Node, selector: string) -> bool {
    if selector=="*" { return true }
    if selector[0]==35 { return node.id==selector[1:] }
    if selector[0]==46 { return Class(node.classes,selector[1:]) }
    return Same(node.tag,selector)
}
Hex :: (c: u8) -> s32 {
    if c>=48 && c<=57 { return cast(s32)c-48 }; c2:=Lower(c)
    if c2>=97 && c2<=102 { return cast(s32)c2-87 }; return -1
}
ColorValue :: (value: string, fallback: u32) -> u32 {
    if value=="transparent" { return 0 }
    if value=="white" { return 0xffffffff }; if value=="black" { return 0x000000ff }
    if value=="red" { return 0xff0000ff }; if value=="blue" { return 0x0000ffff }; if value=="green" { return 0x008000ff }
    if value.count!=4 && value.count!=7 { return fallback }; if value[0]!=35 { return fallback }
    color: u32=0
    for i: 1..cast(s32)value.count-1 {
        digit:=Hex(value[i]); if digit<0 { return fallback }
        if value.count==4 { color=(color<<8) | cast(u32)(digit*17) } else { color=(color<<4) | cast(u32)digit }
    }; return (color<<8) | 255
}
Pixels :: (value: string, fallback: float32) -> float32 {
    n: float32=0.0; found: bool; i: s32=0
    while i<cast(s32)value.count && value[i]>=48 && value[i]<=57 { found=true; n=n*10.0+cast(float32)(value[i]-48); i+=1 }
    if i<cast(s32)value.count && value[i]==46 {
        i+=1; divisor: float32=10.0
        while i<cast(s32)value.count && value[i]>=48 && value[i]<=57 { found=true; n+=cast(float32)(value[i]-48)/divisor; divisor*=10.0; i+=1 }
    }
    suffix:=Trim(value[i:]); if suffix!="" && !Starts(suffix,"px") && !Starts(suffix,"auto") { return fallback }
    if !found { return fallback }; if n>4096.0 { n=4096.0 }; return n
}
Declarations :: (style: *Style, source: string, priorities: []s32, score: s32) {
    start: s32=0
    for i: 0..cast(s32)source.count {
        if i!=cast(s32)source.count && source[i]!=59 { continue }
        declaration:=Trim(source[start:i]); start=i+1; colon:=Find(declaration,":",0); if colon<0 { continue }
        property:=Trim(declaration[:colon]); value:=Trim(declaration[colon+1:]); slot: s32=-1
        if Same(property,"color") { slot=0 } else if Same(property,"background") || Same(property,"background-color") { slot=1 }
        else if Same(property,"font-size") { slot=2 } else if Same(property,"margin") || Same(property,"margin-top") || Same(property,"margin-bottom") { slot=3 }
        else if Same(property,"padding") { slot=4 } else if Same(property,"max-width") || Same(property,"width") { slot=5 }
        else if Same(property,"display") { slot=6 }
        if slot<0 || score<priorities[slot] { continue }; priorities[slot]=score
        if slot==0 { style.color=ColorValue(value,style.color) }
        if slot==1 { style.background=ColorValue(value,style.background) }
        if slot==2 { style.font=cast(s32)Pixels(value,cast(float32)style.font); if style.font<8 { style.font=8 }; if style.font>96 { style.font=96 } }
        if slot==3 { style.margin=Pixels(value,style.margin); if Find(value,"auto",0)>=0 { style.centered=true } }
        if slot==4 { style.padding=Pixels(value,style.padding) }
        if slot==5 { style.width=Pixels(value,style.width) }
        if slot==6 { style.hidden=Same(value,"none") }
    }
}
Resolve :: () {
    nodes[0].style=.{.font=18,.color=0x263246ff,.background=0xffffffff,.padding=24.0}
    for i: 0..count-1 {
        style:=nodes[0].style
        if i>0 { parent:=nodes[nodes[i].parent].style; style=.{.font=parent.font,.color=parent.color,.hidden=parent.hidden} }
        tag:=nodes[i].tag
        if Same(tag,"h1") { style.font=36; style.margin=14.0 }
        if Same(tag,"h2") { style.font=28; style.margin=12.0 }
        if Same(tag,"h3") { style.font=22; style.margin=10.0 }
        if Same(tag,"p") || Same(tag,"li") || Same(tag,"pre") { style.margin=8.0 }
        if Same(tag,"ul") || Same(tag,"ol") { style.padding=16.0 }
        if Same(tag,"a") { style.color=0x2563ebff }
        priority: [7]s32
        for r: 0..rule_count-1 { if Matches(nodes[i],rules[r].selector) { Declarations(*style,rules[r].declarations,priority[:],rules[r].specificity) } }
        Declarations(*style,nodes[i].inline_style,priority[:],1000)
        nodes[i].style=style
        if Same(tag,"body") && style.background!=0 { page_color=style.background }
    }
}
Load :: (html: string) {
    count=0; rule_count=0; truncated=false; title[0]=0; page_color=0xffffffff
    unused Add(-1,"document"); stack: [64]s32; depth: s32=1; stack[0]=0; i: s32=0
    while i<cast(s32)html.count && count<Limit {
        if html[i]!=60 {
            end:=Find(html,"<",i); if end<0 { end=cast(s32)html.count }
            value:=html[i:end]
            if Trim(value)!="" {
                node:=Add(stack[depth-1],"#text"); pre: bool
                for d: 0..depth-1 { if Same(nodes[stack[d]].tag,"pre") { pre=true } }
                DecodeText(node,value,pre)
            }; i=end; continue
        }
        if Starts(html[i:],"<!--") { end:=Find(html,"-->",i+4); if end<0 { break }; i=end+3; continue }
        // A quoted attribute may contain >; it does not end its start tag.
        end:=i+1; quote: u8=0
        while end<cast(s32)html.count {
            c:=html[end]
            if quote!=0 { if c==quote { quote=0 } } else if c==34 || c==39 { quote=c } else if c==62 { break }
            end+=1
        }; if end>=cast(s32)html.count { break }
        content:=Trim(html[i+1:end]); i=end+1; if content=="" || content[0]==33 || content[0]==63 { continue }
        closing:=content[0]==47; if closing { content=Trim(content[1:]) }
        name_end: s32=0; while name_end<cast(s32)content.count && !Space(content[name_end]) && content[name_end]!=47 { name_end+=1 }
        tag:=content[:name_end]
        if closing {
            d:=depth-1; while d>=1 { if Same(nodes[stack[d]].tag,tag) { depth=d; break }; d-=1 }; continue
        }
        if Same(tag,"script") || Same(tag,"style") || Same(tag,"title") {
            close:=Find(html,"</",i)
            // Raw-text elements may contain strings such as </p>.
            while close>=0 && !Starts(html[close+2:],tag) { close=Find(html,"</",close+2) }
            if close<0 { break }
            if Same(tag,"style") { ParseCSS(html[i:close]) }
            if Same(tag,"title") { Copy(title[:],Trim(html[i:close])) }
            ending:=Find(html,">",close); if ending<0 { break }; i=ending+1; continue
        }
        if Same(tag,"head") { continue }
        node:=Add(stack[depth-1],tag); if node<0 { break }
        attributes:=content[name_end:]; nodes[node].id=Attribute(attributes,"id"); nodes[node].classes=Attribute(attributes,"class"); nodes[node].href=Attribute(attributes,"href"); nodes[node].inline_style=Attribute(attributes,"style")
        empty:=Same(tag,"br") || Same(tag,"hr") || Same(tag,"img") || Same(tag,"meta") || Same(tag,"link") || Same(tag,"input") || content[content.count-1]==47
        if Same(tag,"img") { alt:=Attribute(attributes,"alt"); if alt!="" { text:=Add(node,"#text"); if text>=0 { DecodeText(text,alt,false) } } }
        if !empty && depth<64 { stack[depth]=node; depth+=1 }
    }
    if i<cast(s32)html.count { truncated=true }
    has_body: bool
    for n: 1..count-1 { if Same(nodes[n].tag,"body") { has_body=true } }
    if !has_body { nodes[0].tag="body" }
    Resolve()
}
TextValue :: (index: s32) -> string { return TextUntilNul(nodes[index].text[:]) }
LayoutNode :: (index: s32, x: float32, y: float32, available: float32) -> float32 {
    style:=nodes[index].style
    if style.hidden { nodes[index].bounds=.{}; return y }
    width:=available-2.0*style.margin; if width<24.0 { width=24.0 }
    if style.width>0.0 && style.width<width { width=style.width }
    left:=x+style.margin; if style.centered { left=x+(available-width)/2.0 }
    top:=y+style.margin; cursor:=top+style.padding
    if nodes[index].size>0 {
        props: TextProps; props.bounds=.{left,top,width,0.0}; props.text=TextValue(index); props.font=style.font; props.class_name=1000+index
        prepared:=PrepareText(props,TextFaceFor(props,DefaultTextFace())); cursor=top+prepared.bounds.height+4.0
    } else if Same(nodes[index].tag,"br") { cursor+=cast(float32)style.font }
    else {
        child:=nodes[index].first
        while child>=0 { cursor=LayoutNode(child,left+style.padding,cursor,width-2.0*style.padding); child=nodes[child].next }
        cursor+=style.padding
    }
    nodes[index].bounds=.{left,top,width,cursor-top}; return cursor+style.margin
}
InstallTextStyles :: (base: StyleRules) {
    active:=base
    for i: 1..count-1 {
        if nodes[i].size==0 || active.count>=320 { continue }
        rule: StyleRule; rule.selector=StyleDefaultSelector(); rule.selector.class_name=1000+i; rule.state=StyleStateAny(); rule.layer=10; rule.order=i
        rule.style.fields=cast(u32)StyleField.StyleForeground | cast(u32)StyleField.StyleFontSize; rule.style.foreground=nodes[i].style.color; rule.style.font_size=cast(float32)nodes[i].style.font
        active.items[active.count]=rule; active.count+=1
    }; unused InstallStyleRules(active)
}
