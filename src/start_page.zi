// The built-in start page, kept in Ziran so the app needs no data files.
Url :: #import "url";

lines: [22]string = .{
    "<!doctype html><html><head><title>Browser</title>",
    "<style>",
    "body { background: #f4f7fb; color: #263246; padding: 20px; }",
    "main { max-width: 760px; margin: 12px auto; padding: 26px; background: white; }",
    "h1 { font-size: 38px; color: #254c7b; }",
    "h2 { color: #254c7b; font-size: 26px; }",
    ".quiet { color: #67768b; font-size: 15px; }",
    "a { color: #2468bc; }",
    "</style></head><body><main>",
    "<p class='quiet'>ZIRAN + KRYON</p>",
    "<h1>A small browser, built from scratch.</h1>",
    "<p>Enter a web address or a file URL above. HTML becomes a document tree, CSS styles that tree, and Kryon draws the page.</p>",
    "<h2>Simple pages, clearly rendered</h2>",
    "<p>Headings, paragraphs, lists, links, preformatted text and image descriptions work here. Text wraps to the window and the page scrolls independently.</p>",
    "<p>Styles can set colors, backgrounds, font sizes, spacing, widths and visibility using element, class, ID and inline selectors.</p>",
    "<h2>A first engine</h2>",
    "<p>This early browser supports embedded and inline CSS and bounded classic inline JavaScript. Scripts can find elements by ID or simple selectors, change their textContent and set the page title.</p>",
    "<p>The DOM is a basic snapshot. External and module scripts, events, timers, forms, image decoding, external stylesheets, flexbox and grid are not supported yet. Complex sites may fail; JavaScript errors remain visible.</p>",
    "<a href='https://example.com'>Visit example.com</a>",
    "<p class='quiet'>No Chromium or WebKit rendering engine. Pages load outside the UI frame.</p>",
    "</main></body></html>",
    ""
};

// Writes the page into OUT and returns its length.
#program_export
Write :: (out: []u8) -> s32 {
    length: s32 = 0
    for line: lines {
        length = Url.Append(out, length, line)
        length = Url.Append(out, length, "\n")
    }
    if length < 0 { return 0 }
    return length
}
