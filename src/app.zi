using UI :: #import "kryon/Widgets";
using Document :: #import "document";
State :: #import "state";
Window :: #import "desktop";
Desktop :: #import "kryon/Desktop";
ScrollDevice :: #import "kryon/ScrollDevice";
SystemStyle :: #import "kss/SystemStyle";
SystemThemeLinux :: #import "kryon/SystemThemeLinux";
#import "std/text_buffer"
#import "std/timer_linux"
theme_ready: bool;
base: StyleRules;

Action :: (session: Session, id: s32, label: string, bounds: Rectangle, enabled: bool) -> bool {
    Window.Record(id,label,bounds.x,bounds.y,bounds.width,bounds.height,enabled)
    props: ButtonProps; props.key=cast(u64)id; props.id=id; props.bounds=bounds; props.label=label; props.disabled=!enabled
    return Button(session,props)==1
}
Paint :: (session: Session, viewport: Rectangle) {
    Document.height=Document.LayoutNode(0,viewport.x,0.0,viewport.width)
    pointer:=Desktop.PollPointer()
    ScrollDevice.BeginScrollFrame(session,.{pointer.x,pointer.y},pointer.pressed,pointer.down,pointer.released,PointerWheelTake(session,viewport),cast(float64)MonotonicMilliseconds()/1000.0)
    scroll_props: ScrollProps; scroll_props.key=200; scroll_props.bounds=viewport; scroll_props.content_height=cast(s32)Document.height; scroll_props.scroll_offset=State.scroll
    scrolling:=Scroll(session,scroll_props); State.scroll=scrolling.scroll_offset
    for i: 0..Document.count-1 {
        node: *Node=*Document.nodes[i]; bounds:=node.bounds; bounds.y+=viewport.y-cast(float32)State.scroll
        if node.style.hidden || bounds.height<=0.0 || bounds.y+bounds.height<viewport.y || bounds.y>viewport.y+viewport.height { continue }
        if node.style.background!=0 { box: BoxProps; box.key=cast(u64)(300+i); box.bounds=bounds; box.fill=ColorFromPacked(node.style.background); Box(session,box) }
        if node.size==0 { continue }
        link:=node.parent
        while link>0 && Document.nodes[link].href=="" { link=Document.nodes[link].parent }
        if link>0 {
            props: LinkProps; props.key=cast(u64)(1000+i); props.class_name=1000+i; props.bounds=bounds; props.text=Document.TextValue(i); props.link=Document.nodes[link].href; props.focus_id=1000+i; props.disabled=State.loading
            Window.Record(1000+i,props.text,bounds.x,bounds.y,bounds.width,bounds.height,!State.loading)
            result:=Link(session,props); if result.open_url { State.Navigate(result.url); break }
        } else {
            props: TextProps; props.key=cast(u64)(1000+i); props.class_name=1000+i; props.bounds=bounds; props.text=Document.TextValue(i); props.font=node.style.font; props.selectable=true
            Text(session,props)
        }
    }
    if scrolling.opened { unused End(session) }
}
#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    Window.control_count=0; defer { Window.Publish() }
    if !theme_ready {
        SystemStyle.StyleInstallSystem(SystemThemeLinux.SystemPaletteRead()); base=ActiveStyleRules(); theme_ready=true
    }
    State.Tick()
    if State.changed { Document.InstallTextStyles(base); State.changed=false }
    key:=KeyboardTake(session); modifiers:=KeyboardModifiers(session); typed_bytes: [256]u8; typed:=TypedTextTake(session,typed_bytes[:])
    if (modifiers & KeyModifierControl)!=0 && key==76 { State.focused=true; State.anchor=0; State.cursor=cast(s32)TextUntilNul(State.address[:]).count }
    chrome: BoxProps; chrome.key=1; chrome.bounds=viewport; chrome.fill=StyleTokenColor("surface"); Box(session,chrome)
    x:=viewport.x+12.0; y:=viewport.y+10.0; width:=viewport.width-24.0
    if Action(session,10,"Back",.{x,y,62.0,38.0},!State.loading && State.position>0) { State.Back(-1) }
    if Action(session,11,"Next",.{x+68.0,y,62.0,38.0},!State.loading && State.position+1<State.history_count) { State.Back(1) }
    if Action(session,12,"Home",.{x+136.0,y,62.0,38.0},!State.loading) { State.Navigate("about:start") }
    field_bounds: Rectangle=.{x+210.0,y,width-280.0,38.0}
    result:=AddressField(session,field_bounds,key,modifiers,typed); State.cursor=result.cursor; State.anchor=result.anchor; State.focused=result.focused
    if result.edit.changed { State.Edit(result.edit.start,result.edit.end,result.edit.replacement) }
    Window.Record(20,"Address",field_bounds.x,field_bounds.y,field_bounds.width,field_bounds.height,true)
    if Action(session,13,ifx State.loading then "Wait" else "Go",.{x+width-62.0,y,62.0,38.0},!State.loading) || (result.committed && !State.loading) { State.Navigate(TextUntilNul(State.address[:])); State.focused=false }
    page: Rectangle=.{viewport.x,viewport.y+60.0,viewport.width,viewport.height-92.0}
    background: BoxProps; background.key=2; background.bounds=page; background.fill=ColorFromPacked(Document.page_color); Box(session,background)
    if Document.count>0 { Paint(session,page) }
    status: TextProps; status.key=3; status.bounds=.{x,viewport.y+viewport.height-26.0,width,22.0}; status.text=TextUntilNul(State.message[:]); status.font=13; status.wrap=TextWrap.TextWrapNone; Text(session,status)
    return 0
}
AddressField :: (session: Session, bounds: Rectangle, key: s32, modifiers: s32, typed: string) -> TextFieldResult {
    field: TextFieldProps; field.key=20; field.focus_id=20; field.bounds=bounds; field.value=TextUntilNul(State.address[:]); field.label="Address"; field.placeholder="https://example.com or file:///path/page.html"; field.cursor=State.cursor; field.anchor=State.anchor; field.focused=State.focused; field.max_bytes=4096
    if field.focused { field.input=TextFieldInputFor(key,modifiers,typed) }
    return TextField(session,field)
}
