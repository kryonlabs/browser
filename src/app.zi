BoxWidget :: #import "kryon/box";
TooltipWidget :: #import "kryon/tooltip";
ButtonWidget :: #import "kryon/button";
LinkWidget :: #import "kryon/link";
ScrollWidget :: #import "kryon/scroll";
TextWidget :: #import "kryon/text";
TextFieldWidget :: #import "kryon/text_field";
using Geometry :: #import "kryon/geometry";
using Drawing :: #import "kryon/drawing_props";
using Sessions :: #import "kryon/session";
using StyleSheet :: #import "kryon/style_sheet";
using TreeInput :: #import "kryon/tree_input";
using KeyInput :: #import "kryon/key_input";
using InputProtocol :: #import "kryon/input_protocol";
Tree :: #import "kryon/tree";
using Document :: #import "document";
State :: #import "state";
Window :: #import "desktop";
Desktop :: #import "kryon/desktop_runtime";
ScrollDevice :: #import "kryon/ScrollDevice";
SystemTheme :: #import "kryon/SystemTheme";
SystemThemeLinux :: #import "kryon/SystemThemeLinux";
#import "std/text_buffer"
#import "std/timer_linux"
theme_ready: bool;
base: StyleRules;
tooltips: [5]TooltipWidget.TooltipState;

Action :: (session: Session, id: s32, label: string, bounds: Rectangle, enabled: bool) -> bool {
    Window.Record(id,label,bounds.x,bounds.y,bounds.width,bounds.height,enabled)
    props: ButtonWidget.Props; props.key=cast(u64)id; props.id=id; props.bounds=bounds; props.label=label; props.disabled=!enabled; props.icon_only=true
    if id==10 { props.icon_shape="S2rr:M19 12H5M12 5L5 12L12 19" }
    if id==11 || id==13 { props.icon_shape="S2rr:M5 12H19M12 5L19 12L12 19" }
    if id==12 { props.icon_shape="S2rr:M3 10L12 3L21 10V21H15V14H9V21H3Z" }
    if id==14 { props.icon_shape=ifx State.loading then "S2rr:M6 6L18 18M18 6L6 18" else "S2rr:M20 7V3M20 7H16M20 7C17 2 9 2 5 7C1 12 4 21 12 21C16 21 19 19 21 15" }
    return ButtonWidget.Draw(session,props)==1
}
Paint :: (session: Session, viewport: Rectangle) {
    Document.height=Document.LayoutNode(0,viewport.x,0.0,viewport.width)
    pointer:=Desktop.PollPointer()
    ScrollDevice.BeginScrollFrame(session,.{pointer.x,pointer.y},pointer.pressed,pointer.down,pointer.released,PointerWheelTake(session,viewport),cast(float64)MonotonicMilliseconds()/1000.0)
    scroll_props: ScrollWidget.Props; scroll_props.key=200; scroll_props.bounds=viewport; scroll_props.content_height=cast(s32)Document.height; scroll_props.scroll_offset=State.scroll
    scrolling:=ScrollWidget.Draw(session,scroll_props); State.scroll=scrolling.scroll_offset
    for i: 0..Document.count-1 {
        node: *Node=*Document.nodes[i]; bounds:=node.bounds; bounds.y+=viewport.y-cast(float32)State.scroll
        if node.style.hidden || bounds.height<=0.0 || bounds.y+bounds.height<viewport.y || bounds.y>viewport.y+viewport.height { continue }
        if node.style.background!=0 { box: BoxWidget.Props; box.key=cast(u64)(300+i); box.bounds=bounds; box.fill=ColorFromPacked(node.style.background); unused BoxWidget.Draw(session,box) }
        if node.size==0 { continue }
        link:=node.parent
        while link>0 && Document.nodes[link].href=="" { link=Document.nodes[link].parent }
        if link>0 {
            props: LinkWidget.Props; props.key=cast(u64)(1000+i); props.class_name=1000+i; props.bounds=bounds; props.text=Document.TextValue(i); props.link=Document.nodes[link].href; props.focus_id=1000+i; props.disabled=State.loading
            Window.Record(1000+i,props.text,bounds.x,bounds.y,bounds.width,bounds.height,!State.loading)
            result:=LinkWidget.Draw(session,props); if result.open_url { State.Navigate(result.url); break }
        } else {
            props: TextWidget.Props; props.key=cast(u64)(1000+i); props.class_name=1000+i; props.bounds=bounds; props.text=Document.TextValue(i); props.size=node.style.font; props.selectable=true
            TextWidget.Draw(session,props)
        }
    }
    if scrolling.opened { unused Tree.End(session) }
}
#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    Window.control_count=0; defer { Window.Publish() }
    if !theme_ready {
        unused SystemTheme.SystemPaletteInstall(SystemThemeLinux.SystemPaletteRead()); base=ActiveStyleRules(); theme_ready=true
    }
    State.Tick()
    if State.changed { Document.InstallTextStyles(base); State.changed=false }
    key:=KeyboardTake(session); modifiers:=KeyboardModifiers(session); typed_bytes: [256]u8; typed:=TypedTextTake(session,typed_bytes[:])
    if (modifiers & KeyModifierControl)!=0 && key==76 { State.focused=true; State.anchor=0; State.cursor=cast(s32)TextUntilNul(State.address[:]).count }
    chrome: BoxWidget.Props; chrome.key=1; chrome.bounds=viewport; chrome.fill=StyleTokenColor("surface"); unused BoxWidget.Draw(session,chrome)
    x:=viewport.x+12.0; y:=viewport.y+10.0; width:=viewport.width-24.0
    if Action(session,10,"Back",.{x,y,38.0,38.0},!State.loading && State.position>0) { State.Back(-1) }
    if Action(session,11,"Next",.{x+44.0,y,38.0,38.0},!State.loading && State.position+1<State.history_count) { State.Back(1) }
    if Action(session,12,"Home",.{x+88.0,y,38.0,38.0},!State.loading) { State.Navigate("about:start") }
    if Action(session,14,ifx State.loading then "Stop loading" else "Reload",.{x+132.0,y,38.0,38.0},true) { if State.loading { State.Stop() } else { State.Reload() } }
    field_bounds: Rectangle=.{x+182.0,y,width-232.0,38.0}
    result:=AddressField(session,field_bounds,key,modifiers,typed); State.cursor=result.cursor; State.anchor=result.anchor; State.focused=result.focused
    if result.edit.changed { State.Edit(result.edit.start,result.edit.end,result.edit.replacement) }
    Window.Record(20,"Address",field_bounds.x,field_bounds.y,field_bounds.width,field_bounds.height,true)
    if Action(session,13,"Go",.{x+width-38.0,y,38.0,38.0},true) || result.committed { if State.loading { State.Stop() }; State.Navigate(TextUntilNul(State.address[:]),true,true); State.focused=false }
    page: Rectangle=.{viewport.x,viewport.y+60.0,viewport.width,viewport.height-92.0}
    background: BoxWidget.Props; background.key=2; background.bounds=page; background.fill=ColorFromPacked(Document.page_color); unused BoxWidget.Draw(session,background)
    if Document.count>0 { Paint(session,page) }
    if State.loading {
        indicator: BoxWidget.Props; indicator.key=4; indicator.bounds=.{viewport.x,viewport.y+56.0,viewport.width,3.0}; indicator.fill=StyleTokenColorOr("accent",ColorFromPacked(0x4c8dffff)); unused BoxWidget.Draw(session,indicator)
    }
    status: TextWidget.Props; status.key=3; status.bounds=.{x,viewport.y+viewport.height-26.0,width,22.0}; status.text=TextUntilNul(State.message[:]); status.size=13; status.wrap=.TextWrapNone; TextWidget.Draw(session,status)
    // Draw overlays last so the page cannot cover them.
    pointer:=Desktop.PollPointer()
    for i: 0..Window.control_count-1 {
        id:=Window.control_ids[i]
        if id<10 || id>14 { continue }
        bounds:=Window.control_bounds[i]
        tip: TooltipWidget.Props; tip.key=cast(u64)(5000+id); tip.anchor=.{bounds[0],bounds[1],bounds[2],bounds[3]}; tip.viewport=viewport
        tip.text=TextUntilNul(Window.control_labels[i][:]); tip.now_ms=MonotonicMilliseconds(); tip.delay_ms=500
        tip.pointer.over_anchor=pointer.x>=bounds[0] && pointer.x<bounds[0]+bounds[2] && pointer.y>=bounds[1] && pointer.y<bounds[1]+bounds[3]
        unused TooltipWidget.Draw(session,tip,*tooltips[id-10])
    }
    return 0
}
AddressField :: (session: Session, bounds: Rectangle, key: s32, modifiers: s32, typed: string) -> TextFieldWidget.Result {
    field: TextFieldWidget.Props; field.key=20; field.focus_id=20; field.bounds=bounds; field.value=TextUntilNul(State.address[:]); field.label="Address"; field.placeholder="https://example.com or file:///path/page.html"; field.cursor=State.cursor; field.anchor=State.anchor; field.focused=State.focused; field.max_bytes=4096
    if field.focused { field.input=TextFieldInputFor(key,modifiers,typed) }
    return TextFieldWidget.Draw(session,field)
}
