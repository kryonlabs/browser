Transport :: #import "transport";
Document :: #import "document";
#import "std/text"
#import "std/text_buffer"
#import "std/byte_text_linux"
libc :: #system_library "libc";
Free :: (memory: *void) #foreign libc "free";
started: bool;
loading: bool;
changed: bool;
url: [4097]u8;
address: [4097]u8;
message: [513]u8;
html: [524289]u8;
history: [64][4097]u8;
history_scroll: [64]s32;
position: s32=-1;
history_count: s32;
cursor: s32;
anchor: s32;
focused: bool;
scroll: s32;
pending_remember: bool;
pending_position: s32;
last_target: [4097]u8;

// JSON helpers for the desktop host's state reply (desktop.zi).
Release :: (value: string) { descriptor:=cast(*TextDescriptor)(*value); Free(cast(*void)descriptor.data) }
Quoted :: (out: *Vec(u8), value: string) {
    BuilderPrint(out,"\"")
    for i: 0..cast(s32)value.count-1 {
        byte:=value[i]
        if byte==34 { BuilderPrint(out,"\\\"") } else if byte==92 { BuilderPrint(out,"\\\\") }
        else if byte==10 { BuilderPrint(out,"\\n") } else if byte>=32 { BuilderPrint(out,"%",value[i:i+1]) }
    }; BuilderPrint(out,"\"")
}
Property :: (out: *Vec(u8), key: string, value: string) { BuilderPrint(out,",\"%\":",key); Quoted(out,value) }
Set :: (out: []u8, value: string) { Document.Copy(out,value) }
// A TYPED address stands alone; a link resolves against the current page.
Navigate :: (target: string, remember: bool=true, typed: bool=false) {
    if loading || target=="" { return }
    if remember && position>=0 { history_scroll[position]=scroll }
    pending_position=position
    pending_remember=remember
    Set(last_target[:],target)
    base: [4097]u8; if !typed { Set(base[:],TextUntilNul(url[:])) }
    loading=Transport.Start(target,TextUntilNul(base[:]))
    if loading { Set(last_target[:],TextView(Transport.request_url[0:Transport.request_length])) }
    Set(message[:],ifx loading then "Loading…" else Transport.error)
}
Stop :: () {
    unused Transport.Stop(); loading=false; position=pending_position; pending_remember=false; Set(message[:],"Loading stopped")
}
Reload :: () {
    if position>=0 { history_scroll[position]=scroll }
    target: [4097]u8; Set(target[:],TextUntilNul(last_target[:]))
    if target[0]==0 { Set(target[:],TextUntilNul(url[:])) }
    Navigate(TextUntilNul(target[:]),TextUntilNul(target[:])!=TextUntilNul(url[:]),true)
}
Back :: (delta: s32) {
    if loading || position+delta<0 || position+delta>=history_count { return }
    previous:=position; history_scroll[position]=scroll; position+=delta; target: [4097]u8; Set(target[:],TextUntilNul(history[position][:])); Navigate(TextUntilNul(target[:]),false); pending_position=previous
}
Tick :: () {
    if !started { started=true; Navigate("about:start") }
    if !Transport.Poll() { return }; loading=false
    if Transport.error!="" { position=pending_position; pending_remember=false; Set(message[:],Transport.error); return }
    if pending_remember {
        if position>=63 { for i: 0..cast(s32)62 { history[i]=history[i+1]; history_scroll[i]=history_scroll[i+1] }; position=62 }
        position+=1; history_count=position+1; history_scroll[position]=0
    }
    pending_remember=false
    Set(url[:],Transport.CurrentUrl()); Set(html[:],Transport.Html()); Set(address[:],TextUntilNul(url[:])); Set(history[position][:],TextUntilNul(url[:]))
    Set(last_target[:],TextUntilNul(url[:]))
    Document.Load(TextUntilNul(html[:])); changed=true; scroll=history_scroll[position]; cursor=cast(s32)TextUntilNul(address[:]).count; anchor=cursor
    if Document.script_error[0]!=0 {
        out: Vec(u8); BuilderPrint(*out,"JavaScript: % (limited browser APIs)",TextUntilNul(Document.script_error[:]))
        status:=BuilderFinish(out); Set(message[:],status); Release(status)
    }
    else if Document.scripts_unsupported>0 { Set(message[:],"Limited compatibility: external/module scripts are not supported") }
    else { Set(message[:],ifx Document.truncated then "Page preview limit reached" else TextUntilNul(Document.title[:])) }
}
Edit :: (start: s32, end: s32, replacement: string) {
    copied: [4097]u8; Set(copied[:],replacement)
    length:=cast(s32)TextUntilNul(address[:]).count; inserted:=cast(s32)replacement.count
    if start<0 || end<start || end>length || length-(end-start)+inserted>=4097 { return }
    shift:=inserted-(end-start)
    if shift>0 { i:=length; while i>=end { address[i+shift]=address[i]; i-=1 } }
    else { for i: end..length { address[i+shift]=address[i] } }
    for i: 0..inserted-1 { address[start+i]=copied[i] }
}
